{
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-review.sh",
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ]
    },
    "permissions": {
        "allow": ["Bash(.claude/hooks/pre-commit-review.sh --mark)"]
    }
}
